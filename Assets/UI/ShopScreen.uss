.screen {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    flex-direction: column;
    padding: 84px 32px 28px;
    background-color: rgb(248, 250, 252);
}

.page-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
}

.screen-title {
    font-size: 30px;
    -unity-font-style: bold;
    color: rgb(30, 41, 59);
}

.balance-card {
    min-width: 180px;
    padding: 14px 20px;
    background-color: rgb(255, 255, 255);
    border-radius: 12px;
    border-width: 1px;
    border-color: rgb(226, 232, 240);
}

.balance-label {
    font-size: 13px;
    color: rgb(100, 116, 139);
    margin-bottom: 4px;
}

.balance-value {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(22, 101, 52);
}

.feedback {
    min-height: 24px;
    margin-bottom: 12px;
    color: rgb(30, 41, 59);
    font-size: 14px;
}

.items-container {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    width: 100%;
}

.items-container .unity-scroll-view__content-container {
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
}

.item-card {
    width: 300px;
    min-width: 220px;
    max-width: 380px;
    flex-grow: 1;
    flex-shrink: 1;

    padding: 18px;
    margin: 8px;

    background-color: rgb(255, 255, 255);
    border-radius: 12px;
    border-width: 1px;
    border-color: rgb(226, 232, 240);
}

.item-title {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(30, 41, 59);
    white-space: normal;
    margin-bottom: 10px;
}

.item-description {
    flex-grow: 1;
    color: rgb(71, 85, 105);
    white-space: normal;
    margin-bottom: 16px;
}

.item-price {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(22, 101, 52);
    margin-bottom: 12px;
}

.item-button {
    min-height: 38px;
    background-color: rgb(37, 99, 235);
    color: rgb(255, 255, 255);
    border-radius: 7px;
    border-width: 0;
}

.item-button:hover {
    background-color: rgb(29, 78, 216);
}

.item-button:disabled {
    background-color: rgb(148, 163, 184);
    color: rgb(255, 255, 255);
}
