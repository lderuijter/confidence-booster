.screen {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    flex-direction: column;
    padding: 84px 32px 28px;
    background-color: rgb(248, 250, 252);
}

.screen-title {
    font-size: 30px;
    -unity-font-style: bold;
    color: rgb(30, 41, 59);
    margin-bottom: 24px;
}

.items-container {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    width: 100%;
}

.items-container .unity-scroll-view__content-container {
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
}

.item-card {
    width: 300px;
    min-width: 220px;
    max-width: 380px;
    flex-grow: 1;
    flex-shrink: 1;

    padding: 18px;
    margin: 8px;

    background-color: rgb(255, 255, 255);
    border-radius: 12px;
    border-width: 1px;
    border-color: rgb(226, 232, 240);
}

.item-title {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(30, 41, 59);
    white-space: normal;
    margin-bottom: 10px;
}

.item-description {
    color: rgb(71, 85, 105);
    white-space: normal;
    margin-bottom: 16px;
}

.item-price {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(22, 101, 52);
    margin-top: 4px;
}

.empty-message {
    flex-grow: 1;
    color: rgb(100, 116, 139);
    font-size: 16px;
    -unity-text-align: middle-center;
    white-space: normal;
    margin-top: 12px;
}
