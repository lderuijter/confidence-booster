<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="ShopScreen.uss" />

    <ui:VisualElement name="shop-root" class="screen">

        <ui:VisualElement class="page-header">
            <ui:Label
                text="Shop"
                class="screen-title" />

            <ui:VisualElement class="balance-card">
                <ui:Label
                    text="Jouw saldo"
                    class="balance-label" />

                <ui:Label
                    name="coin-balance"
                    text="Coins: 0"
                    class="balance-value" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:Label
            name="shop-feedback"
            class="feedback" />

        <ui:ScrollView
            name="shop-items"
            class="items-container" />

    </ui:VisualElement>
</ui:UXML>